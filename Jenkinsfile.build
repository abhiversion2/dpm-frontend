pipeline {
    agent { label 'awslinux' }

    environment {
        // DOCKERHUB_USERNAME = 'vishwakarmaabhijeet739'
        AWS_REGION      = 'us-east-1'
        AWS_ACCOUNT_ID  = '742231077713'
        ECR_REPO        = 'hogan-dpm-frontend'
        ECR_URL         = "742231077713.dkr.ecr.us-east-1.amazonaws.com/hogan-dpm-frontend"
        CONTAINER_NAME     = 'hogan-dpm-frontend-container'
        IMAGE_NAME         = 'hogan-dpm-frontend'
        PORT               = '80'
        // SONAR_PROJECT_KEY  = 'abhiversion2_dpm-frontend'
        // SONAR_ORG          = 'abhiversion2'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
                sh 'npm ci'
            }
        }

        stage('ESLint') {
            steps {
                sh 'npm run lint -- --format json --output-file eslint-report.json || true'
            }
        }

        stage('Test') {
            steps {
                sh 'node scripts/test-ci.js'
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'test-results/junit.xml'
                }
            }
        }

        // stage('SonarCloud Analysis') {
        //     steps {
        //         withCredentials([string(credentialsId: 'sonarcloud-token', variable: 'SONAR_TOKEN')]) {
        //             sh """
        //                 npx sonar-scanner \
        //                     -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
        //                     -Dsonar.organization=${SONAR_ORG} \
        //                     -Dsonar.host.url=https://sonarcloud.io \
        //                     -Dsonar.login=${SONAR_TOKEN} \
        //                     -Dsonar.sources=src \
        //                     -Dsonar.tests=src \
        //                     -Dsonar.test.inclusions=**/*.test.js,**/*.test.jsx \
        //                     -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info \
        //                     -Dsonar.eslint.reportPaths=eslint-report.json \
        //                     -Dsonar.qualitygate.wait=true \
        //                     -Dsonar.qualitygate.timeout=300
        //             """
        //         }
        //     }
        // }

        stage('Build & Tag Docker Image') {
            steps {
                script {
                    def tags = getImageTags(env.BRANCH_NAME, env.BUILD_NUMBER)
                    sh """
                        docker build \
                        -t ${ECR_URL}:${tags.build} \
                        -t ${ECR_URL}:${tags.latest} \
                        .
                    """
                }
            }
        }
        
        stage('Login to AWS ECR') {
            steps {
                sh """
                    aws ecr get-login-password --region ${AWS_REGION} \
                    | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                """
            }
        }

        stage('Push Image to ECR') {
            steps {
                script {
                    def tags = getImageTags(env.BRANCH_NAME, env.BUILD_NUMBER)
                    sh """
                        docker push ${ECR_URL}:${tags.build}
                        docker push ${ECR_URL}:${tags.latest}
                    """
                }
            }
        }


        stage('Deploy') {
            steps {
                script {
                    def tags = getImageTags(env.BRANCH_NAME, env.BUILD_NUMBER)
                    sh """
                        docker stop ${CONTAINER_NAME} || true
                        docker rm ${CONTAINER_NAME} || true

                        docker run -d \
                        --name ${CONTAINER_NAME} \
                        -p ${PORT}:80 \
                        --restart unless-stopped \
                        ${ECR_URL}:${tags.latest}
                    """
                }
                echo "Deployment completed successfully!"
            }
        }

        stage('Verify Deployment') {
            steps {
                sh """
                    docker ps --filter name=${CONTAINER_NAME} --format '{{.Status}}' | grep -i up
                    echo "App accessible at http://<your-server-ip>:${PORT}"
                """
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline succeeded! React app deployed via Docker."
        }
        failure {
            echo "❌ Pipeline failed. Check logs for details."
        }
        always {
            sh 'docker image prune -f || true'
            cleanWs()
        }
    }
}

// ── Shared helper — eliminates duplicated envTag logic ─────────────────────────
def getImageTags(String branch, String buildNumber) {
    def envTag = branch == 'develop' ? 'dev' : branch == 'test' ? 'test' : 'build'
    return [
        build : "${envTag}-${buildNumber}",
        latest: "${envTag}-latest"
    ]
}