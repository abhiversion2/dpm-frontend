pipeline {
    agent { label 'awslinux' }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    if (env.JOB_NAME.contains('frontend')) {
                        sh 'npm ci'
                    } else {
                        // Backend: replace with your command (e.g. mvn dependency:go-offline, pip install, etc.)
                        sh 'echo "Backend dependency install here"'
                    }
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    sh 'npm run build'
                }
            }
        }
    }
    post {
        always {
            script {
                if (env.WORKSPACE) {
                    cleanWs()
                }
            }
        }
    }
}